rules_version = '2';

// 아벨학원 홈페이지 보안 규칙
// Firebase 콘솔 → Firestore Database → 규칙 탭에 이 내용을 통째로 붙여 넣고 '게시'하세요.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/students/$(request.auth.uid)).data;
    }
    function isStudent() {
      return signedIn()
        && exists(/databases/$(database)/documents/students/$(request.auth.uid))
        && me().active == true;
    }
    function validName(n) {
      return n is string && n.size() >= 1 && n.size() <= 20;
    }
    // 승인 없이 가입한 관리자 수 (처음 2명까지만 허용)
    function slotsUsed() {
      return exists(/databases/$(database)/documents/meta/adminSlots) ? get(/databases/$(database)/documents/meta/adminSlots).data.count : 0;
    }

    // ── 관리자 ─────────────────────────────────────────
    match /admins/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      // ① 처음 2명: 스스로 가입하면 바로 관리자 (같은 저장에서 meta/adminSlots 숫자를 1 올려야 함)
      allow create: if signedIn() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/students/$(uid))
        && slotsUsed() < 2
        && getAfter(/databases/$(database)/documents/meta/adminSlots).data.count == slotsUsed() + 1
        && request.resource.data.keys().hasOnly(['name', 'email', 'via', 'createdAt'])
        && request.resource.data.via == 'founder'
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.name)
        && request.resource.data.createdAt == request.time;
      // ② 그 뒤로는 이미 등록된 관리자가 가입 신청을 승인해야 관리자가 됨
      allow create: if isAdmin()
        && exists(/databases/$(database)/documents/adminRequests/$(uid))
        && !existsAfter(/databases/$(database)/documents/adminRequests/$(uid))
        && request.resource.data.keys().hasOnly(['name', 'email', 'via', 'approvedBy', 'createdAt'])
        && request.resource.data.via == 'approved'
        && request.resource.data.approvedBy == request.auth.uid
        && request.resource.data.name == get(/databases/$(database)/documents/adminRequests/$(uid)).data.name
        && request.resource.data.email == get(/databases/$(database)/documents/adminRequests/$(uid)).data.email
        && request.resource.data.createdAt == request.time;
      // 다른 관리자를 해제할 수 있음 (자기 자신은 해제 불가)
      allow delete: if isAdmin() && request.auth.uid != uid;
      allow update: if false;
    }

    // 승인 없이 가입한 관리자 수: 관리자 문서를 만들 때 함께 1씩만 올릴 수 있음
    match /meta/adminSlots {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['count'])
        && request.resource.data.count == 1
        && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/admins/$(request.auth.uid)).data.via == 'founder';
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['count'])
        && resource.data.count < 2
        && request.resource.data.count == resource.data.count + 1
        && !exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/admins/$(request.auth.uid)).data.via == 'founder';
      allow delete: if false;
    }

    // 관리자 가입 신청: 본인만 만들 수 있고, 관리자가 승인(관리자 등록)하거나 거절(삭제)
    match /adminRequests/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && !exists(/databases/$(database)/documents/students/$(uid))
        && !isAdmin()
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && validName(request.resource.data.name)
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow update: if false;
    }

    // ── 학생(일반 회원) ───────────────────────────────────
    // 학생이 직접 가입하거나 관리자가 만듦. 학생은 자기 정보만 읽고 접속 기록만 갱신
    match /students/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && !exists(/databases/$(database)/documents/admins/$(uid))
            && !exists(/databases/$(database)/documents/adminRequests/$(uid))
            && request.resource.data.keys().hasOnly(['name', 'grade', 'loginId', 'active', 'loginCount', 'lastLoginAt', 'createdAt', 'selfSignup'])
            && validName(request.resource.data.name)
            && request.resource.data.grade in ['고1', '고2', '고3']
            && request.resource.data.loginId is string
            && request.resource.data.loginId.matches('^[a-z0-9]{3,20}$')
            && request.auth.token.email.split('@')[0] == request.resource.data.loginId
            && request.resource.data.active == true
            && request.resource.data.loginCount == 0
            && request.resource.data.lastLoginAt == null
            && request.resource.data.selfSignup == true
            && request.resource.data.createdAt == request.time);
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isStudent() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt', 'loginCount'])
            && request.resource.data.lastLoginAt == request.time
            && request.resource.data.loginCount == resource.data.loginCount + 1);
    }

    // 접속 기록: 학생이 로그인할 때 자기 기록만 추가, 관리자만 열람·삭제
    match /logins/{id} {
      allow read, delete: if isAdmin();
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'grade', 'loginId', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.grade == me().grade
        && request.resource.data.loginId == me().loginId
        && request.resource.data.at == request.time;
      allow update: if false;
    }

    // ── 보충 강의 ─────────────────────────────────────────
    // 목록: 사용 중인 학생과 관리자만 열람, 관리자만 등록·삭제
    match /videos/{id} {
      allow read: if isAdmin() || isStudent();
      allow write: if isAdmin();
    }

    // 시청 내역: 학생이 영상을 열 때 자기 기록만 추가, 관리자만 열람·삭제
    match /views/{id} {
      allow read, delete: if isAdmin();
      allow create: if isStudent()
        && request.resource.data.keys().hasOnly(['uid', 'name', 'grade', 'loginId', 'videoId', 'title', 'subject', 'videoGrade', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.grade == me().grade
        && request.resource.data.loginId == me().loginId
        && request.resource.data.videoId is string
        && exists(/databases/$(database)/documents/videos/$(request.resource.data.videoId))
        && request.resource.data.title is string && request.resource.data.title.size() <= 80
        && request.resource.data.subject is string && request.resource.data.videoGrade is string
        && request.resource.data.at == request.time;
      allow update: if false;
    }

    // ── 학원 소식(공지) ───────────────────────────────────
    match /notices/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['category', 'title', 'body', 'date', 'createdAt'])
        && request.resource.data.category in ['공지', '안내', '설명회', '모집', '행사']
        && request.resource.data.title is string && request.resource.data.title.size() >= 1 && request.resource.data.title.size() <= 100
        && request.resource.data.body is string && request.resource.data.body.size() <= 3000
        && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      allow delete: if isAdmin();
    }

    // ── 상담·특강 신청서 ──────────────────────────────────
    // 누구나 신청할 때 1건 추가, 관리자만 열람·상태 변경·삭제
    match /applications/{id} {
      allow read, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['type', 'studentName', 'grade', 'phone', 'subjects', 'preferredTime', 'message', 'month', 'status', 'createdAt'])
        && request.resource.data.type in ['입학 상담', '특강 신청']
        && validName(request.resource.data.studentName)
        && request.resource.data.grade in ['중학교 1학년', '중학교 2학년', '중학교 3학년', '고등학교 1학년', '고등학교 2학년', '고등학교 3학년']
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9+() -]{8,20}$')
        && request.resource.data.subjects is list
        && request.resource.data.subjects.size() <= 3
        && request.resource.data.subjects.hasOnly(['국어', '영어', '수학'])
        && request.resource.data.preferredTime in ['', '평일 오후', '평일 저녁', '주말']
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 2000
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.status == 'new'
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['new', 'contacted'];
    }
  }
}
